{
  "name": "tapir-hyparquet-solid",
  "private": true,
  "version": "0.1.0",
  "description": "DNS Tapir parquet viewer built with SolidJS and hyparquet",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome check --write --linter-enabled=false",
    "test": "vitest run --dir test",
    "typecheck": "tsc"
  },
  "dependencies": {
    "hyparquet": "^1.31.4",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@solidjs/testing-library": "^0.8.10",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.4"
  }
}
