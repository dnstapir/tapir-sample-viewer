    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "hyparquet-writer": "^0.16.12",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.4"
